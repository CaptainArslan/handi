# Production values. Copy to backend/.env on the server and fill in every blank.
APP_NAME=Handi
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://handi.hegemonicinc.com

HANDI_TIMEZONE=Asia/Karachi
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=handi
DB_USERNAME=handi
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Behind Cloudflare or a load balancer, set to * so HTTPS links and client IPs are right.
TRUSTED_PROXIES=

# Photos: `public` keeps them on this server (storage/app/public, needs `php artisan storage:link`).
# Switch to `s3` for Cloudflare R2 / AWS S3 and fill in the AWS_* values below.
MEDIA_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=handi-media
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_URL=https://media.hegemonicinc.com   # public bucket / custom domain
AWS_USE_PATH_STYLE_ENDPOINT=false

HANDI_APP_NAME="What to Cook"
HANDI_SHUFFLES_PER_DAY=5
HANDI_SUPPORT_EMAIL=support@handi.hegemonicinc.com
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=60
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
API_VERSION=1.0.0

# Mail is needed for password-reset and change-email codes.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="What to Cook"

# Only used by `php artisan db:seed`. Prefer `php artisan handi:create-admin you@example.com` in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Telescope stays off in production unless you are debugging (super admins only when on).
TELESCOPE_ENABLED=false

# true = make photo thumbnails in the background; needs the queue worker (deploy/handi-worker.conf).
MEDIA_QUEUE_CONVERSIONS=false

# Website, admin and Telescope
ADMIN_PATH=admin
TELESCOPE_ALLOWED_EMAILS=admin@handi.test
# Store pages, once the apps are published (the website shows "Coming soon" until then)
HANDI_ANDROID_URL=
HANDI_IOS_URL=
# Email buttons. Default: the web app on APP_URL (/app/today, /app/forgot-password)
# HANDI_LINK_TODAY=handi://today
# HANDI_LINK_RESET_PASSWORD=handi://forgot-password
