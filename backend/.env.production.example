# Production values. Copy to backend/.env on the server and fill in every blank.
APP_NAME=Handi
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.handi.pk

HANDI_TIMEZONE=Asia/Karachi
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=handi
DB_USERNAME=handi
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Images on Cloudflare R2 (S3-compatible). For AWS S3: drop AWS_ENDPOINT, set a real region.
MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=handi-media
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_URL=https://media.handi.pk          # public bucket / custom domain
AWS_USE_PATH_STYLE_ENDPOINT=false

HANDI_APP_NAME="What to Cook"
HANDI_SHUFFLES_PER_DAY=5
HANDI_SUPPORT_EMAIL=
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=60
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=
API_VERSION=1.0.0

# Mail is needed for password-reset and change-email codes.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="What to Cook"

# Only used by `php artisan db:seed`. Prefer `php artisan handi:create-admin you@example.com` in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
