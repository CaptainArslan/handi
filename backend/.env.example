APP_NAME=Handi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=handi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------- Handi
# App name used in push notification titles and emails.
HANDI_APP_NAME="What to Cook"
# Default timezone for new users ("today", picks and meal dates are per user).
HANDI_TIMEZONE=Asia/Karachi
# How many times a day a user can shuffle their 3 picks.
HANDI_SHUFFLES_PER_DAY=5
# Shown in the legal pages and emails.
HANDI_SUPPORT_EMAIL=support@handi.app

# Where dish photos go: "public" locally, "s3" for S3 / Cloudflare R2 (fill the AWS_* keys above).
MEDIA_DISK=public

# Weather: Open-Meteo, free and keyless. Change only to point at a proxy.
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_MINUTES=60

# Expo push. EXPO_ACCESS_TOKEN only if "Enhanced push security" is on in your Expo account.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

# API docs at /docs/api (open to everyone when APP_ENV=local, super admins only otherwise).
API_VERSION=1.0.0

# First super admin for /admin, created by `php artisan db:seed`. Leave blank in production
# and use `php artisan handi:create-admin you@example.com` instead.
ADMIN_NAME="Handi Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional demo app user with a full kitchen + 2 weeks of history (local testing only).
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
