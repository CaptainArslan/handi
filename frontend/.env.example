# The only setting the app needs: your Laravel server's address (no /api path, no trailing slash).
# Copy to .env (never committed) and restart with `npx expo start -c` after changing it.
#   Phone with Expo Go (same Wi-Fi):  http://<your PC's LAN IP>:8000   ← run `php artisan serve --host=0.0.0.0 --port=8000`
#   Android emulator:                 http://10.0.2.2:8000
# A `.test` / `localhost` address does NOT work on a phone.
# Production builds read it from EAS environment variables instead (see README).
EXPO_PUBLIC_API_BASE_URL=http://handi-backend.test/api/v1
