{
  "expo": {
    "name": "Handi",
    "slug": "handi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "handi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.hegemonic.handi",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hegemonic.handi",
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/splash-logo.png",
            "imageWidth": 200
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0F5C4D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Handi uses your location only to check today’s weather.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Handi uses your photos so you can add a picture of your dish.",
          "cameraPermission": "Handi uses the camera so you can take a picture of your dish.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb9d31af-2c7f-489e-bfe7-f3f149692a44"
      }
    },
    "owner": "captainarslan0"
  }
}
