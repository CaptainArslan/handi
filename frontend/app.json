{
  "expo": {
    "name": "Handi",
    "slug": "handi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "handi",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.hegemonic.handi"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.hegemonic.handi"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0F5C4D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Handi uses your location only to check today’s weather."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Handi uses your photos so you can add a picture of your dish.",
          "cameraPermission": "Handi uses the camera so you can take a picture of your dish."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb9d31af-2c7f-489e-bfe7-f3f149692a44"
      }
    },
    "owner": "captainarslan0"
  }
}