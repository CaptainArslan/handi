# Same rules as the repo-root .easignore, written relative to frontend/ in case EAS reads this one.
node_modules/
/android/
/ios/
/.expo/
/dist/
/dist-web/
/web-build/
*.tgz
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
# google-services.json IS uploaded: the Android build needs it for push (it holds no secret).
# Firebase service-account key (secret) — never uploaded; it goes into EAS credentials instead
*firebase-adminsdk*.json
