# What EAS Build uploads. When this file exists EAS uses it INSTEAD of .gitignore,
# so it repeats the important ignores. The app only needs frontend/.

# Not part of the app (the Laravel storage symlink also breaks the upload on Windows)
/backend/
/docs/
/.github/
/_old/
/marketing/
/reels/
/Claude outputs/
/package-lock.json

# App build output and caches (EAS runs prebuild itself)
node_modules/
/frontend/android/
/frontend/ios/
/frontend/.expo/
/frontend/dist/
/frontend/dist-web/
/frontend/web-build/
*.tgz
*.log
.DS_Store
Thumbs.db

# Secrets: the build reads EXPO_PUBLIC_API_BASE_URL from EAS environment variables
.env
.env.*
!.env.example
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
# google-services.json IS uploaded: the Android build needs it for push (it holds no secret).
# Firebase service-account key (secret) — never uploaded; it goes into EAS credentials instead
*firebase-adminsdk*.json
